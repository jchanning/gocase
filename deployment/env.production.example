# env.production.example — Template for GoCaSE production environment
#
# Copy to: /home/opc/gocase/.env.production on the OCI server
# Do NOT commit the real .env.production to git.
#
# Generate a strong DB password: openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────
# Used by the PostgreSQL container and the app container.
# Change this before first deployment — it cannot be changed easily afterwards
# without recreating the database volume.
DB_PASSWORD=change_me_to_a_strong_random_password

# ── OCI Generative AI (for "Generate from Notes" feature) ─────────────
# Find these values in the OCI Console:
#   Profile menu → Tenancy: <your-tenancy>  (for TENANCY_OCID)
#   Identity → Users → your user → API Keys  (for FINGERPRINT)
#   Identity → Compartments  (for COMPARTMENT_ID)
#
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaa_REPLACE_ME
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaa_REPLACE_ME
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=uk-london-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaa_REPLACE_ME
OCI_GENAI_MODEL_ID=meta.llama-3.3-70b-instruct

# The private key file is placed at /home/opc/gocase-data/oci_api_key.pem
# and mounted read-only into the container at /app/oci_api_key.pem.
# No env var needed for the path — it is hardcoded in docker-compose.prod.yml.

# ── OCI Budget Alert reminder ─────────────────────────────────────────
# After deploying, set a monthly budget alert in the OCI Console to avoid
# unexpected GenAI charges:
#   OCI Console → Billing & Cost Management → Budgets → Create Budget
#   Recommended: $10/month threshold with email alert at 80% and 100%.
